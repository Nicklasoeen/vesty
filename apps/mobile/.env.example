# Simulator / Expo web on this Mac (loopback):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321

# Physical iPhone: 127.0.0.1 is the phone itself, so auth will fail.
# Use the Mac's LAN IP on the same Wi-Fi instead, for example:
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:55321
# Keep .env untracked. Do not commit a personal LAN IP.

EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
