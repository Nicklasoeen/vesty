{
  "name": "vesty",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "start": "pnpm --filter @vesty/mobile start",
    "mobile": "pnpm --filter @vesty/mobile start",
    "ios": "pnpm --filter @vesty/mobile ios",
    "android": "pnpm --filter @vesty/mobile android",
    "lint": "pnpm --filter @vesty/mobile lint",
    "typecheck": "pnpm --filter @vesty/mobile typecheck",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "test:db": "supabase test db --local supabase/tests",
    "test:market-data": "node --experimental-strip-types --test supabase/functions/_shared/market-data/*.test.ts",
    "test:fx": "node --experimental-strip-types --test supabase/functions/_shared/fx/*.test.ts",
    "test:packages": "node --experimental-strip-types --test apps/mobile/src/features/clubs/*.test.ts apps/mobile/src/features/home/*.test.ts apps/mobile/src/features/invest/*.test.ts apps/mobile/src/features/portfolio/*.test.ts apps/mobile/src/lib/*.test.ts apps/mobile/src/navigation/*.test.ts apps/mobile/src/theme/*.test.ts apps/mobile/src/ui/*.test.ts"
  },
  "devDependencies": {
    "supabase": "2.116.0"
  }
}
